# GEMINI_API_KEY: Google Gemini models (AI Chat V1 prefers this when set).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OPENAI_API_KEY: OpenAI models for AI Chat V1 (second priority when Gemini is unset).
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# ANTHROPIC_API_KEY: Anthropic Claude models for AI Chat V1 (third priority).
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# APP_URL: Injected automatically by AI Studio for routing.
APP_URL="YOUR_APP_URL"

# VITE_ENABLE_KNOWLEDGE_MOCK_UI: Show Knowledge Center mock UI in admin (default off).
# This is a frontend prototype only — does NOT wire server/knowledge routes.
# VITE_ENABLE_KNOWLEDGE_MOCK_UI=true

# VITE_ENABLE_PROPOSAL_STUDIO: Show Solar Proposal Studio in Sales (default off).
# VITE_ENABLE_PROPOSAL_STUDIO=true

# VITE_ENABLE_SUNCHASER_DESIGN_STUDIO: Canonical CRM Design Project / Roof Studio flag.
# Default ON when unset. Set to false to hide Design Project from Sales Advisor.
# Opens Project Design Workspace (HelioScope layout) — not the old standalone Roof CAD.
# VITE_ENABLE_SUNCHASER_DESIGN_STUDIO=true
# VITE_ENABLE_SUNCHASER_DESIGN_STUDIO=false

# VITE_ENABLE_ROOF_STUDIO: Legacy opt-in flag (true only). Still unlocks Design Project
# if set, for older deployments. Prefer VITE_ENABLE_SUNCHASER_DESIGN_STUDIO.
# VITE_ENABLE_ROOF_STUDIO=true

# Google Maps Provider V1 (Design Studio geocoding, Places autocomplete + satellite).
# Off by default. Requires both flag=true and a non-empty API key.
# Places Autocomplete uses the same key (enable Places API + Geocoding + Static Maps in Google Cloud).
# Never commit a real key. Do not log or display the key in the UI.
VITE_ENABLE_GOOGLE_MAPS_PROVIDER=false
VITE_GOOGLE_MAPS_API_KEY=

# --- SUPABASE PRODUCTION DATABASE CONFIGURATIONS ---
# Configure these once you provision your database inside your Supabase.com dashboard.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-bypasses-rls-secure-backend"
SUPABASE_ANON_KEY="your-supabase-anon-key-public-client"

# JWT_SECRET: HS256 signing key. Required in production (min 32 chars; not a placeholder).
JWT_SECRET="generate-a-random-secure-alphanumeric-secret-here-32-chars"
# JWT_EXPIRES_IN: Access token lifetime (jsonwebtoken format, e.g. 8h, 1d, 7d). Required in production.
JWT_EXPIRES_IN="8h"

# PUBLIC_LEAD_API_KEY: Server-only secret for POST /api/public/leads (marketing lead gateway).
# Never expose to the browser or Vite env (no VITE_ prefix). Send as X-Public-Lead-Key or Bearer.
PUBLIC_LEAD_API_KEY="generate-a-long-random-server-only-public-lead-api-key"
# Optional rate limit for the public lead gateway (per IP).
# PUBLIC_LEAD_RATE_LIMIT_WINDOW_MS=60000
# PUBLIC_LEAD_RATE_LIMIT_MAX=30

# --- WHATSAPP CONVERSATIONS (server-only; never use VITE_ prefixes) ---
# Disabled by default. Requires Supabase + scripts/whatsapp-transport-schema.sql (manual apply).
WHATSAPP_CONVERSATIONS_ENABLED=false
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Graph API version (e.g. v21.0). If unset, a replaceable local fallback is used — set explicitly for deployments.
WHATSAPP_GRAPH_API_VERSION=
# Public HTTPS origin of the *backend* (Render), NOT the Vercel frontend.
# Meta webhook callback = ${PUBLIC_BASE_URL}/api/whatsapp/webhook
# Example: PUBLIC_BASE_URL=https://sunchaser-energy-systems.onrender.com
# PUBLIC_BASE_URL=https://your-backend.onrender.com
# Embedded Signup (also set matching VITE_META_* for the admin UI build):
# WHATSAPP_APP_ID=
# WHATSAPP_META_CONFIG_ID=
# WHATSAPP_TOKEN_ENCRYPTION_KEY=  # 32-byte hex (64 chars) or base64
# VITE_META_APP_ID=
# VITE_META_CONFIG_ID=
# VITE_META_GRAPH_VERSION=v21.0
