# GEMINI_API_KEY: Required for Gemini AI Sunchaser assistant and scoring diagnostics.
# AI Studio automatically injects this from secrets panel at runtime.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Injected automatically by AI Studio for routing.
APP_URL="YOUR_APP_URL"

# --- SUPABASE PRODUCTION DATABASE CONFIGURATIONS ---
# Configure these once you provision your database inside your Supabase.com dashboard.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-bypasses-rls-secure-backend"
SUPABASE_ANON_KEY="your-supabase-anon-key-public-client"

# JWT_SECRET: HS256 signing key. Required in production (min 32 chars; not a placeholder).
JWT_SECRET="generate-a-random-secure-alphanumeric-secret-here-32-chars"
# JWT_EXPIRES_IN: Access token lifetime (jsonwebtoken format, e.g. 8h, 1d, 7d). Required in production.
JWT_EXPIRES_IN="8h"
# LEGACY_HEADER_AUTH: Temporary bridge for unmigrated /api/* routes only.
# - true: middleware may accept X-Sunchaser-* headers (audited) when Bearer JWT is absent.
# - false (recommended): middleware requires Bearer JWT only; headers are ignored here.
#   Route handlers that still read X-Sunchaser-* directly remain unmigrated — do not treat
#   LEGACY_HEADER_AUTH=false as full API hardening until those handlers are migrated.
LEGACY_HEADER_AUTH="false"
