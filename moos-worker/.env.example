# Moos worker environment — staging
# NEVER commit real values. Production values live in Railway encrypted variables.
#
# The worker holds NO Meta credentials. All WhatsApp sends execute inside the
# CRM via the /api/moos/* action endpoints (Bearer <redacted>).

# Postgres for the worker queue (can share the CRM database; uses wa_* tables)
DATABASE_URL=<redacted>

# Signed relay from the CRM (must match the CRM's RELAY_SECRET)
RELAY_SECRET=<redacted>

# Non-secret binding: the worker only processes relay events for this number
MOOS_PHONE_NUMBER_ID=243825222156651

# CRM internal API (Bearer <redacted>)
CRM_BASE_URL=https://crm.sunchaserenergy.co
MOOS_SERVICE_TOKEN=<redacted>

# Master kill switch — keep false until Allauddin approves live tests
ENABLE_AUTOSEND=false

# Optional LLM classifier (deterministic rules engine is the default)
MOOS_DECISION_URL=
FAQ_FILE=./faqs.json

PORT=3000
NODE_ENV=production
